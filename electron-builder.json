{
    "appId": "tl.wallet.1",
    "productName": "TradeLayer-Wallet",
    "files": [
      "dist/**/*",
      "dist/tradelayer/node_modules/**/*"
    ],
 "extraResources": [
    {
      "from": "trading-algos",
      "to": "trading-algos",
      "filter": ["**/*"]
    }
  ],
    "directories": {
      "output": "release",
      "buildResources": "dist"
    },
    "asar": false,
   "nsis": {
  "oneClick": false,
  "allowToChangeInstallationDirectory": true,
  "include": "builder/installer.nsh"
},
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "dist/fe/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "dist/fe/assets/icon.png"
    },
    "mac": {
      "target": "default",
      "icon": "dist/fe/assets/icon512.png"
    }
  }