{
  "compilerOptions": {
    "esModuleInterop": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "removeComments": true,
    "sourceMap": false,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "lib": ["ES2020"]
  },
  "include": [
    "builder/**/*",
    "declarations.d.ts",
  ],
}
